NODE_ENV=development
PORT=5000

# MongoDB Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/aironauts

# Redis Configuration (BullMQ & PubSub)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# AI Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Sourcing Search Provider (Optional - falls back to High-Fidelity Mock Search Engine)
SERPER_API_KEY=

# Email Provider (Optional - falls back to In-Memory/Database Outbox)
EMAIL_PROVIDER=mock
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=recruiter@aironauts.ai

